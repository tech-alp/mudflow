{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/mudflow-session-start.sh",
            "commandWindows": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/mudflow-session-start.js\"",
            "timeout": 10,
            "statusMessage": "Checking Mudflow session context"
          }
        ]
      }
    ]
  }
}
